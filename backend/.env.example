# Copy to .env for local development: cp .env.example .env
# Real environment variables take precedence over values in .env.

# --- App ---
# development | production
APP_ENV=development
# HTTP port the API listens on
PORT=8080

# --- PostgreSQL ---
# Inside docker compose use the service name as host, e.g. @postgres:5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vuathau?sslmode=disable

# --- Redis ---
# Inside docker compose use redis:6379
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
# Redis logical database number (integer)
REDIS_DB=0

# --- Auth (JWT, HS256) ---
# REQUIRED, at least 32 characters: the API refuses to start otherwise.
# Replace with a long random string, e.g. `openssl rand -base64 48`.
# docker compose (deployments/) also reads JWT_SECRET from this backend/.env.
JWT_SECRET=CHANGE_ME
# Access token lifetime, must be > 0 (Go duration: 15m, 1h, 24h, ...)
JWT_EXPIRY=24h

# --- CORS / WebSocket origins ---
# Comma-separated list of allowed origins; "*" allows any origin
# (with "*" the Access-Control-Allow-Credentials header is not sent)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting (per client IP, in-memory token bucket) ---
# Sustained requests per second (float, must be > 0)
RATE_LIMIT_RPS=10
# Maximum burst size (integer, must be > 0)
RATE_LIMIT_BURST=20
