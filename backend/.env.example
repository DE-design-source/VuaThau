# Copy to .env for local development: cp .env.example .env
# Real environment variables take precedence over values in .env.

# --- App ---
# development | production
APP_ENV=development
# HTTP port the API listens on
PORT=8080

# --- PostgreSQL (BẮT BUỘC mã hoá UTF8) ---
# Inside docker compose use the service name as host, e.g. @postgres:5432
# Máy dev không có Postgres: go run ./cmd/devdb (Postgres nhúng, cổng 5432)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vuathau?sslmode=disable

# --- Redis (chỉ dùng cho /health; không có thì API vẫn chạy) ---
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Auth (JWT, HS256) ---
# REQUIRED, at least 32 characters: the API refuses to start otherwise.
# Replace with a long random string, e.g. `openssl rand -base64 48`.
JWT_SECRET=CHANGE_ME
# Hạn token. App điện thoại giữ đăng nhập lâu: mặc định 30 ngày (Go duration)
JWT_EXPIRY=720h

# --- CORS / WebSocket origins ---
# Chỉ cần khi web chạy ở tên miền khác API. Web phục vụ cùng tên miền (STATIC_DIR / Caddy) thì không cần.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Rate limiting (per client IP, in-memory token bucket) ---
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=40

# ====================== Nghiệm thu ======================

# Thư mục ảnh hồ sơ (anh/) và biên lai (bienlai/). SAO LƯU thư mục này cùng Postgres.
DATA_DIR=./data
# Địa chỉ web quản lý (ghi vào file thông tin trên Google Drive)
PUBLIC_URL=https://nghiemthu.vuathau.com.vn
# Thư mục build của web (frontend/dist). Đặt thì API phục vụ luôn web ở "/" (không cần Caddy file_server).
STATIC_DIR=

# AI đọc ảnh (Claude): đặt key là bật. Trống: CTV tự điền thông tin công trình.
ANTHROPIC_API_KEY=
# Chỉ cần khi key là loại cá nhân (sk-ant-usr-...): mã workspace wrkspc_...
ANTHROPIC_WORKSPACE_ID=
AI_MODEL=claude-opus-5-5

# Địa chỉ từ GPS cho camera trong app: trống thì dùng OpenStreetMap (miễn phí).
GOOGLE_MAPS_API_KEY=

# Đăng nhập / đăng ký bằng Google trong app: OAuth client loại "Web application". Trống: app ẩn nút Google.
GOOGLE_CLIENT_IDS=

# Lưu mỗi hồ sơ gửi duyệt thành 1 thư mục trên Google Drive. Thiếu 1 trong 4 giá trị: tắt.
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=
GDRIVE_FOLDER=
