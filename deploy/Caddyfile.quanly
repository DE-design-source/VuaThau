# Vua Thầu nghiệm thu: backend Go phục vụ cả API (/api/v1) và web quản lý (STATIC_DIR = frontend/dist).
# App CTV gọi https://nghiemthu.vuathau.com.vn/api/v1, nên khi chuyển hẳn sang backend Go thì trỏ tên miền này vào container API.
#
# Máy chủ dùng chung: Caddy của QS Pro (qspro-web-1) giữ cổng 80/443. Container API (vtnt-api, xem deploy/server)
# phải nối thêm mạng qspro_default để Caddy gọi được. Chép khối dưới vào /opt/qspro/infra/deploy/Caddyfile
# (thay khối nghiemthu cũ khi đã chuyển dữ liệu xong), rồi reload Caddy.
nghiemthu.vuathau.com.vn {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Ảnh tải lên tới 20 MB/ảnh, tối đa 20 ảnh/lần: không giới hạn body ở Caddy, API tự kiểm.
	reverse_proxy vtnt-api:8080
}
