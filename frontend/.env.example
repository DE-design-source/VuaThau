# Đường dẫn tới máy chủ Nghiệm thu (chung dữ liệu với app CTV).
# Mặc định /nt: đi qua proxy cùng tên miền (Vite khi dev, Caddy khi chạy thật) nên không cần CORS.
VITE_NT_URL=/nt

# Dev: máy chủ mà Vite proxy /nt chuyển tới (vd máy chủ chạy local: http://localhost:8000)
NT_PROXY_TARGET=https://nghiemthu.vuathau.com.vn

# Backend Go của repo (chưa dùng cho nghiệm thu)
VITE_API_URL=/api/v1
# VITE_WS_URL=ws://localhost:8080
